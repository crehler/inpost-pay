{% sw_extends '@Storefront/storefront/page/checkout/cart/index.html.twig' %}

{% block page_checkout_cart_action_proceed %}
    {{ parent() }}

    {% set displayConfig = inpostPayConfig ? inpostPayConfig.getDisplayConfig('BASKET_SUMMARY') : null %}

    {% if inpostPayConfig and displayConfig and displayConfig.displayed %}
        <div class="inpost-pay-widget-container cart-summary-inpost mt-3"
             style="{{ displayConfig.getHtmlStyles().toCssString() }}">
            <inpost-izi-button
                binding_place="BASKET_SUMMARY"
                {% if displayConfig.variation %}variation="{{ displayConfig.variation }}"{% endif %}
                {% if displayConfig.maxWidthPx %}style="max-width: {{ displayConfig.maxWidthPx }}px"{% endif %}>
            </inpost-izi-button>
        </div>
    {% endif %}
{% endblock %}
