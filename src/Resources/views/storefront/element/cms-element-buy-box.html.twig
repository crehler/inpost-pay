{% sw_extends '@Storefront/storefront/element/cms-element-buy-box.html.twig' %}

{% block buy_widget_ordernumber_container %}
    {% set displayConfig = inpostPayConfig ? inpostPayConfig.getDisplayConfig('PRODUCT_CARD') : null %}

    {% if inpostPayConfig and displayConfig and displayConfig.displayed %}
        {% block inpost_pay_widget_button %}
            <div class="inpost-pay-widget-container" style="{{ displayConfig.htmlStyles.toCssString() }}">
                <inpost-izi-button
                        data-product-id="{{ product.id }}"
                        binding_place="PRODUCT_CARD"
                        {% if displayConfig.variation %}variation="{{ displayConfig.variation }}"{% endif %}
                        {% if displayConfig.maxWidthPx %}style="max-width: {{ displayConfig.maxWidthPx }}px"{% endif %}>
                </inpost-izi-button>
            </div>
        {% endblock %}
    {% endif %}

    {{ parent() }}
{% endblock %}
