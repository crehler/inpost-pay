export default "{% block inpost_consents_manager %}\n<div class=\"inpost-consents-manager\">\n    <sw-card :title=\"$tc('inpost-consents-manager.title')\" :isLoading=\"isLoading\">\n        <template #toolbar>\n            <sw-button\n                variant=\"primary\"\n                size=\"small\"\n                @click=\"addConsent\">\n                {{ $tc('inpost-consents-manager.buttons.add') }}\n            </sw-button>\n        </template>\n\n        <template v-if=\"consents.length\">\n            <sw-data-grid\n                :dataSource=\"consents\"\n                :columns=\"columns\"\n                :showSelection=\"false\"\n                :showActions=\"true\">\n\n                <template #column-requirementType=\"{ item }\">\n                    <sw-label\n                        :variant=\"item.requirementType === 'OPTIONAL' ? 'neutral' : 'info'\"\n                        size=\"small\"\n                        appearance=\"pill\">\n                        {{ getRequirementTypeLabel(item.requirementType) }}\n                    </sw-label>\n                </template>\n\n                <template #column-enabled=\"{ item }\">\n                    <sw-icon\n                        v-if=\"item.enabled\"\n                        name=\"regular-checkmark-xs\"\n                        color=\"#37d046\"\n                        small>\n                    </sw-icon>\n                    <sw-icon\n                        v-else\n                        name=\"regular-times-s\"\n                        color=\"#de294c\"\n                        small>\n                    </sw-icon>\n                </template>\n\n                <template #actions=\"{ item }\">\n                    <sw-context-menu-item @click=\"editConsent(item)\">\n                        {{ $tc('inpost-consents-manager.buttons.edit') }}\n                    </sw-context-menu-item>\n                    <sw-context-menu-item @click=\"toggleEnabled(item)\">\n                        {{ item.enabled ? $tc('inpost-consents-manager.buttons.disable') : $tc('inpost-consents-manager.buttons.enable') }}\n                    </sw-context-menu-item>\n                    <sw-context-menu-item variant=\"danger\" @click=\"deleteConsent(item)\">\n                        {{ $tc('inpost-consents-manager.buttons.delete') }}\n                    </sw-context-menu-item>\n                </template>\n            </sw-data-grid>\n        </template>\n\n        <template v-else>\n            <p class=\"inpost-consents-manager__empty-text\">\n                {{ $tc('inpost-consents-manager.emptyState.text') }}\n            </p>\n        </template>\n    </sw-card>\n\n    \n    <sw-modal\n        v-if=\"showModal\"\n        :title=\"currentConsentIndex !== null ? $tc('inpost-consents-manager.modal.titleEdit') : $tc('inpost-consents-manager.modal.titleAdd')\"\n        @modal-close=\"closeModal\"\n        variant=\"large\">\n\n        <div class=\"inpost-consents-manager__modal-content\">\n            \n            <sw-card :title=\"$tc('inpost-consents-manager.modal.basicSettings')\">\n                <sw-text-field\n                    v-model=\"currentConsent.id\"\n                    :label=\"$tc('inpost-consents-manager.fields.id')\"\n                    :placeholder=\"$tc('inpost-consents-manager.placeholders.id')\"\n                    :disabled=\"currentConsentIndex !== null\"\n                    required>\n                </sw-text-field>\n\n                <sw-single-select\n                    v-model=\"currentConsent.requirementType\"\n                    :options=\"requirementTypes\"\n                    :label=\"$tc('inpost-consents-manager.fields.requirementType')\"\n                    labelProperty=\"label\"\n                    valueProperty=\"value\">\n                </sw-single-select>\n\n                <sw-text-field\n                    v-model=\"currentConsent.version\"\n                    :label=\"$tc('inpost-consents-manager.fields.version')\"\n                    :placeholder=\"$tc('inpost-consents-manager.placeholders.version')\">\n                </sw-text-field>\n\n                <sw-switch-field\n                    v-model=\"currentConsent.enabled\"\n                    :label=\"$tc('inpost-consents-manager.fields.enabled')\">\n                </sw-switch-field>\n            </sw-card>\n\n            \n            <sw-card :title=\"$tc('inpost-consents-manager.modal.linkSettings')\">\n                <sw-single-select\n                    v-model=\"currentConsent.linkType\"\n                    :options=\"linkTypes\"\n                    :label=\"$tc('inpost-consents-manager.fields.linkType')\"\n                    labelProperty=\"label\"\n                    valueProperty=\"value\">\n                </sw-single-select>\n\n                <sw-entity-single-select\n                    v-if=\"currentConsent.linkType === 'cms_page'\"\n                    v-model=\"currentConsent.cmsPageId\"\n                    entity=\"cms_page\"\n                    :criteria=\"cmsPageCriteria\"\n                    :label=\"$tc('inpost-consents-manager.fields.cmsPage')\"\n                    :placeholder=\"$tc('inpost-consents-manager.placeholders.cmsPage')\">\n                </sw-entity-single-select>\n\n                <sw-entity-single-select\n                    v-if=\"currentConsent.linkType === 'category'\"\n                    v-model=\"currentConsent.cmsPageId\"\n                    entity=\"category\"\n                    :criteria=\"categoryCriteria\"\n                    :label=\"$tc('inpost-consents-manager.fields.category')\"\n                    :placeholder=\"$tc('inpost-consents-manager.placeholders.category')\">\n                </sw-entity-single-select>\n\n                <sw-text-field\n                    v-if=\"currentConsent.linkType === 'external'\"\n                    v-model=\"currentConsent.externalLink\"\n                    :label=\"$tc('inpost-consents-manager.fields.externalLink')\"\n                    :placeholder=\"$tc('inpost-consents-manager.placeholders.externalLink')\">\n                </sw-text-field>\n            </sw-card>\n\n            \n            <sw-card :title=\"$tc('inpost-consents-manager.modal.translations')\">\n                <div class=\"inpost-consents-manager__locale-buttons\">\n                    <sw-button\n                        v-for=\"locale in availableLocales\"\n                        :key=\"locale\"\n                        :variant=\"activeLocale === locale ? 'primary' : 'ghost'\"\n                        size=\"small\"\n                        @click=\"onLocaleChange(locale)\">\n                        {{ locale }}\n                    </sw-button>\n                </div>\n\n                <div class=\"inpost-consents-manager__translation-fields\">\n                    <sw-textarea-field\n                        :value=\"getCurrentTranslation().description\"\n                        @input=\"updateCurrentTranslation('description', $event)\"\n                        :label=\"$tc('inpost-consents-manager.fields.description')\"\n                        :placeholder=\"$tc('inpost-consents-manager.placeholders.description')\"\n                        :rows=\"3\">\n                    </sw-textarea-field>\n\n                    <sw-text-field\n                        :value=\"getCurrentTranslation().labelLink\"\n                        @input=\"updateCurrentTranslation('labelLink', $event)\"\n                        :label=\"$tc('inpost-consents-manager.fields.labelLink')\"\n                        :placeholder=\"$tc('inpost-consents-manager.placeholders.labelLink')\">\n                    </sw-text-field>\n                </div>\n            </sw-card>\n        </div>\n\n        <template #modal-footer>\n            <sw-button @click=\"closeModal\" size=\"small\">\n                {{ $tc('inpost-consents-manager.buttons.cancel') }}\n            </sw-button>\n            <sw-button variant=\"primary\" size=\"small\" @click=\"saveConsent\">\n                {{ $tc('inpost-consents-manager.buttons.save') }}\n            </sw-button>\n        </template>\n    </sw-modal>\n</div>\n{% endblock %}\n";