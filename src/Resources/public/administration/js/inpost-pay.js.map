export default "<sw-card-view>\n    <sw-card\n        :title=\"$tc('inpost-order.card.title')\"\n        :isLoading=\"isLoading\"\n    >\n        <template v-if=\"transactions.length === 0 && !isLoading\">\n            <sw-empty-state\n                :title=\"$tc('inpost-order.empty.title')\"\n                :subline=\"$tc('inpost-order.empty.subline')\"\n            />\n        </template>\n\n        <template v-else>\n            <sw-data-grid\n                :dataSource=\"transactions\"\n                :columns=\"transactionColumns\"\n                :showSelection=\"false\"\n                :isLoading=\"isLoading\"\n                :showActions=\"true\"\n            >\n                <template #column-amount=\"{ item }\">\n                    {{ formatAmount(item.amount, item.currency) }}\n                </template>\n\n                <template #column-created_date=\"{ item }\">\n                    {{ formatDate(item.created_date) }}\n                </template>\n\n                <template #column-status=\"{ item }\">\n                    <sw-label\n                        :variant=\"item.status === 'CAPTURED' ? 'success' : 'info'\"\n                        appearance=\"pill\"\n                    >\n                        {{ item.status }}\n                    </sw-label>\n                </template>\n\n                <template #actions=\"{ item }\">\n                    <sw-context-menu-item @click=\"openRefundModal(item)\">\n                        {{ $tc('inpost-order.refund.action') }}\n                    </sw-context-menu-item>\n                </template>\n            </sw-data-grid>\n\n            \n            <template v-for=\"transaction in transactions\">\n                <sw-card\n                    v-if=\"transaction.operations && transaction.operations.length\"\n                    :key=\"transaction.transaction_id\"\n                    :title=\"$tc('inpost-order.operations.title', { id: transaction.transaction_id })\"\n                    class=\"inpost-operations-card\"\n                >\n                    <sw-data-grid\n                        :dataSource=\"transaction.operations\"\n                        :columns=\"[\n                            { property: 'type', label: $tc('inpost-order.operations.type') },\n                            { property: 'status', label: $tc('inpost-order.operations.status') },\n                            { property: 'amount', label: $tc('inpost-order.operations.amount') },\n                            { property: 'operation_date', label: $tc('inpost-order.operations.date') },\n                        ]\"\n                        :showSelection=\"false\"\n                    >\n                        <template #column-amount=\"{ item }\">\n                            {{ formatAmount(item.amount, item.currency) }}\n                        </template>\n                        <template #column-operation_date=\"{ item }\">\n                            {{ formatDate(item.operation_date) }}\n                        </template>\n                    </sw-data-grid>\n                </sw-card>\n            </template>\n        </template>\n    </sw-card>\n\n    \n    <sw-modal\n        v-if=\"showRefundModal\"\n        :title=\"$tc('inpost-order.refund.modalTitle')\"\n        @modal-close=\"closeRefundModal\"\n    >\n        <sw-number-field\n            v-model=\"refundAmount\"\n            :label=\"$tc('inpost-order.refund.amountLabel')\"\n            :min=\"0.01\"\n            :max=\"selectedTransaction ? selectedTransaction.amount : 0\"\n            :digits=\"2\"\n        />\n\n        <sw-text-field\n            v-model=\"externalRefundId\"\n            :label=\"$tc('inpost-order.refund.externalIdLabel')\"\n            :placeholder=\"$tc('inpost-order.refund.externalIdPlaceholder')\"\n        />\n\n        <template #modal-footer>\n            <sw-button @click=\"closeRefundModal\">\n                {{ $tc('inpost-order.refund.cancel') }}\n            </sw-button>\n            <sw-button\n                variant=\"primary\"\n                :isLoading=\"refundLoading\"\n                :disabled=\"!refundAmount || refundAmount <= 0\"\n                @click=\"submitRefund\"\n            >\n                {{ $tc('inpost-order.refund.submit') }}\n            </sw-button>\n        </template>\n    </sw-modal>\n</sw-card-view>\n";